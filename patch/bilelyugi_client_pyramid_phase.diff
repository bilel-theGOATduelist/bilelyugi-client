+//BILEL&&YUGI: Pyramid zone. The Pyramid cards are the face-down banished cards whose code is hidden (0).
+int Game::GetPyramidCount(int p) {
+	int n = 0;
+	for(auto* pcard : dField.remove[p]) {
+		if(pcard && pcard->IsPyramidHidden())
+			++n;
+	}
+	return n;
+}
+static int PyramidLayers(int n) {
+	int layers = 0;
+	while(layers * (layers + 1) / 2 < n)
+		++layers;
+	return layers;
+}
+void Game::OpenPyramidWindow(int p) {
+	pyramidView = p;
+	wPyramid->setText(p == 0 ? L"Pyramid (yours) - cards stay face-down" : L"Pyramid (opponent) - cards stay face-down");
+	wPyramid->setVisible(true);
+	env->setFocus(wPyramid);
+}
+//BILEL&&YUGI: draws the py zone of each player (called at the end of DrawMisc, so windows are drawn above it)
+//The py zone sits between the Graveyard and the Main Deck, one column outwards, smaller than a normal zone (as in the draft).
+void Game::DrawPyramidZones() {
+	if(!dInfo.isInDuel || is_building || is_siding)
+		return;
+	auto* coll = device->getSceneManager()->getSceneCollisionManager();
+	const float pulse = 0.5f + 0.5f * std::sin(device->getTimer()->getTime() / 450.0f);
+	for(int p = 0; p < 2; ++p) {
+		const auto& deck = matManager.getDeck()[p];
+		const auto& grave = matManager.getGrave()[p];
+		const float cx_deck = (deck[0].Pos.X + deck[1].Pos.X) / 2.0f;
+		const float cy_deck = (deck[0].Pos.Y + deck[2].Pos.Y) / 2.0f;
+		const float cy_grave = (grave[0].Pos.Y + grave[2].Pos.Y) / 2.0f;
+		const float dir = (cx_deck > 4.0f) ? 1.0f : -1.0f;
+		const float cx = cx_deck + dir * 1.0f;
+		const float cy = (cy_deck + cy_grave) / 2.0f;
+		const float hw = 0.30f, hh = 0.45f; //half size of the zone (a normal zone is 0.4 x 0.6)
+		irr::core::vector2di pt[4];
+		const float xs[4] = { cx - hw, cx + hw, cx - hw, cx + hw };
+		const float ys[4] = { cy - hh, cy - hh, cy + hh, cy + hh };
+		for(int i = 0; i < 4; ++i)
+			pt[i] = coll->getScreenCoordinatesFrom3DPosition({ xs[i], ys[i], 0.0f });
+		//sort the corners on the screen: top-left, top-right, bottom-left, bottom-right
+		int order[4] = { 0, 1, 2, 3 };
+		std::sort(order, order + 4, [&](int l, int r) { return pt[l].Y < pt[r].Y; });
+		irr::core::vector2di tl = pt[order[0]], tr = pt[order[1]], bl = pt[order[2]], br = pt[order[3]];
+		if(tl.X > tr.X)
+			std::swap(tl, tr);
+		if(bl.X > br.X)
+			std::swap(bl, br);
+		auto lerp = [](const irr::core::vector2di& a, const irr::core::vector2di& b, float t) {
+			return irr::core::vector2di(static_cast<irr::s32>(a.X + (b.X - a.X) * t), static_cast<irr::s32>(a.Y + (b.Y - a.Y) * t));
+		};
+		auto at = [&](float u, float v) {
+			return lerp(lerp(tl, tr, u), lerp(bl, br, u), v);
+		};
+		auto fillquad = [&](const irr::core::vector2di& a, const irr::core::vector2di& b, const irr::core::vector2di& c, const irr::core::vector2di& d, irr::video::SColor color) {
+			//a = top-left, b = top-right, c = bottom-left, d = bottom-right
+			const int steps = std::max({ 2, static_cast<int>((b - a).getLength()), static_cast<int>((d - c).getLength()) });
+			for(int i = 0; i <= steps; ++i) {
+				const float t = static_cast<float>(i) / steps;
+				driver->draw2DLine(lerp(a, b, t), lerp(c, d, t), color);
+			}
+		};
+		//clickable area = inner part of the zone
+		const auto c1 = at(0.1f, 0.1f), c2 = at(0.9f, 0.1f), c3 = at(0.1f, 0.9f), c4 = at(0.9f, 0.9f);
+		irr::core::recti rect(std::min({ c1.X, c2.X, c3.X, c4.X }), std::min({ c1.Y, c2.Y, c3.Y, c4.Y }),
+							  std::max({ c1.X, c2.X, c3.X, c4.X }), std::max({ c1.Y, c2.Y, c3.Y, c4.Y }));
+		btnPyZone[p]->setRelativePosition(rect);
+		btnPyZone[p]->setVisible(true);
+		//glow: three rings around the zone, pulsing slowly
+		const auto glow = [&](int level, float expand) {
+			const int base = (level == 0) ? 150 : (level == 1) ? 105 : 60;
+			const int v = base + static_cast<int>(pulse * (level == 0 ? 105 : 70));
+			const irr::video::SColor col(255, std::min(255, v), std::min(255, v * 3 / 4), static_cast<int>(v / 5));
+			const auto a = at(-expand, -expand), b = at(1.0f + expand, -expand), c = at(-expand, 1.0f + expand), d = at(1.0f + expand, 1.0f + expand);
+			driver->draw2DLine(a, b, col);
+			driver->draw2DLine(b, d, col);
+			driver->draw2DLine(d, c, col);
+			driver->draw2DLine(c, a, col);
+		};
+		glow(2, 0.16f);
+		glow(1, 0.09f);
+		fillquad(tl, tr, bl, br, irr::video::SColor(255, 30, 24, 60));
+		glow(0, 0.03f);
+		//pyramid symbol: 4 tiers of golden blocks (1, 2, 3, 4 blocks), like the layers window
+		const irr::video::SColor block(255, 255, 214, 70), edge(255, 150, 100, 20);
+		const float top = 0.10f, tier_h = 0.12f, gap = 0.012f, block_w = 0.17f;
+		for(int tier = 0; tier < 4; ++tier) {
+			const int count = tier + 1;
+			const float v0 = top + tier * (tier_h + gap), v1 = v0 + tier_h;
+			const float start = 0.5f - (count * block_w + (count - 1) * gap) / 2.0f;
+			for(int k = 0; k < count; ++k) {
+				const float u0 = start + k * (block_w + gap), u1 = u0 + block_w;
+				fillquad(at(u0, v0), at(u1, v0), at(u0, v1), at(u1, v1), block);
+				driver->draw2DLine(at(u0, v1), at(u1, v1), edge);
+			}
+		}
+		const auto tc = at(0.5f, 0.80f);
+		const auto layerstr = epro::format(L"{}", PyramidLayers(GetPyramidCount(p)));
+		const irr::core::ustring utext{ epro::wstringview(layerstr) };
+		DrawShadowText(numFont, utext, irr::core::recti(tc.X - 30, tc.Y - 12, tc.X + 30, tc.Y + 12),
+					   Resize(0, 1, 0, 1), 0xffffffff, 0xff000000, true, true);
+	}
+}
+//BILEL&&YUGI: window with the Pyramid layers (called from DrawSpec, after the GUI)
+void Game::DrawPyramidWindow() {
+	if(!dInfo.isInDuel || is_building || is_siding) {
+		for(int p = 0; p < 2; ++p)
+			btnPyZone[p]->setVisible(false);
+		wPyramid->setVisible(false);
+		return;
+	}
+	if(!wPyramid->isVisible())
+		return;
+	const int p = pyramidView;
+	const int n = GetPyramidCount(p);
+	const int layers = PyramidLayers(n);
+	auto win = wPyramid->getAbsolutePosition();
+	//opaque background behind the cards (the Close button stays visible below)
+	driver->draw2DRectangle(irr::video::SColor(255, 24, 20, 50), irr::core::recti(win.UpperLeftCorner.X + 4, win.UpperLeftCorner.Y + 26, win.LowerRightCorner.X - 4, win.LowerRightCorner.Y - 48));
+	const irr::core::recti area(win.UpperLeftCorner.X + 20, win.UpperLeftCorner.Y + 40, win.LowerRightCorner.X - 20, win.LowerRightCorner.Y - 50);
+	if(layers == 0) {
+		DrawShadowText(textFont, irr::core::ustring{ epro::wstringview(L"No card in this Pyramid") }, area, Resize(0, 1, 0, 1), 0xffffffff, 0xff000000, true, true);
+		return;
+	}
+	float cellH = static_cast<float>(area.getHeight()) / layers;
+	const float maxH = static_cast<float>(area.getWidth()) / layers / 0.72f;
+	if(maxH < cellH)
+		cellH = maxH;
+	if(cellH > 140.0f)
+		cellH = 140.0f;
+	const float cellW = cellH * 0.72f;
+	const float top = area.UpperLeftCorner.Y + (area.getHeight() - cellH * layers) / 2.0f;
+	const float cx = (area.UpperLeftCorner.X + area.LowerRightCorner.X) / 2.0f;
+	auto* cover = imageManager.tCover[p == 0 ? 0 : 1];
+	const irr::core::recti src(irr::core::vector2di(0, 0), irr::core::dimension2di(cover->getOriginalSize()));
+	int index = 0;
+	for(int layer = 1; layer <= layers; ++layer) {
+		const float left = cx - (cellW * layer) / 2.0f;
+		for(int k = 0; k < layer; ++k, ++index) {
+			const irr::core::recti dest(static_cast<irr::s32>(left + k * cellW + 2), static_cast<irr::s32>(top + (layer - 1) * cellH + 2),
+										static_cast<irr::s32>(left + (k + 1) * cellW - 2), static_cast<irr::s32>(top + layer * cellH - 2));
+			if(index < n)
+				driver->draw2DImage(cover, dest, src, nullptr, nullptr, true);
+			else
+				driver->draw2DRectangleOutline(dest, irr::video::SColor(255, 150, 150, 150));
+		}
+	}
+}
